  "item": [
    {
      "name": "1. Register User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generăm un email unic O SINGURĂ DATĂ, la începutul fluxului\r",
              "pm.environment.set(\"userEmail\", \"teodora\" + Date.now() + \"@test.com\");"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"{{userEmail}}\",\r\n  \"password\": \"parolaMea123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/post",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "post"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// CURĂȚAT: Nu mai generăm alt email aici, îl refolosim pe cel de la Register!"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// EXTRAGERE DINAMICĂ SIMULATĂ PENTRU ECHO\r",
              "try {\r",
              "    var jsonData = pm.response.json();\r",
              "    // Dacă e postman-echo, datele trimise de noi vin înapoi în jsonData.json\r",
              "    if (jsonData.json && jsonData.json.password) {\r",
              "        // Generăm un token dinamic bazat pe emailul curent ca să fie Chaining adevărat\r",
              "        var dynamicToken = \"token_\" + btoa(pm.environment.get(\"userEmail\"));\r",
              "        pm.environment.set(\"authToken\", dynamicToken);\r",
              "    } else if (jsonData.token) {\r",
              "        pm.environment.set(\"authToken\", jsonData.token);\r",
              "    }\r",
              "} catch(e) {\r",
              "    // Backup în caz că vine din Header\r",
              "    var tokenHeader = pm.response.headers.get(\"Authorization\");\r",
              "    if (tokenHeader) {\r",
              "        pm.environment.set(\"authToken\", tokenHeader.replace(\"Bearer \", \"\"));\r",
              "    }\r",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"{{userEmail}}\",\r\n  \"password\": \"parolaMea123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/post",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "post"
          ]
        }
      },
      "response": []
    },
